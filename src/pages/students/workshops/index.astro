---
/**
 * STUDENT WORKSHOPS
 *
 * The student-facing view of the training practice. Deliberately NOT a
 * duplicate of /programs/ — that page is the practice catalogue addressed to
 * institutions and buyers; this one is addressed to a student on a phone, in
 * their register, answering "what can I actually turn up to?".
 *
 * Mobile-first budget applies: under 400KB, under 3s on throttled 4G.
 *
 * ⛔ Must not imply enrolment is open, cohorts are confirmed, or outcomes are
 * proven. Status is stated before anything else.
 */
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import PageHero from '../../../components/PageHero.astro';
import CompassRule from '../../../components/CompassRule.astro';
import ProgramStatusBlock from '../../../components/ProgramStatusBlock.astro';
import Button from '../../../components/Button.astro';
import { programLines } from '../../../data/programs.ts';
import { whatsappLink } from '../../../data/company.ts';

const wa = whatsappLink('Hi Navadisha — I am a student and I would like to join a workshop. ');
const inDev = programLines.filter((p) => p.status === 'in-development');

const facts = [
  { label: 'Format', value: 'One-day workshop' },
  { label: 'For', value: 'School and college students' },
  { label: 'Mode', value: 'On-site or hybrid' },
  { label: 'Timing', value: 'Tentatively October 2026' },
  { label: 'Trainer', value: 'Bikash Kadayat' },
];

const honest = [
  {
    q: 'Can I sign up today?',
    a: 'Not yet. You can tell us you are interested, and we will message you when dates are confirmed. Nothing is paid or committed at that point.',
  },
  {
    q: 'Is there a certificate?',
    a: 'Nothing is confirmed. We would rather say that than print a certificate claim on a workshop that has not run.',
  },
  {
    q: 'What does it cost?',
    a: 'Not decided. When it is, it will be published here before anyone is asked to commit.',
  },
  {
    q: 'My college wants to host it. Is that possible?',
    a: 'Yes, and that is the more common route. Ask whoever runs student activities to get in touch, or send us their details and we will contact them.',
  },
];
---

<Base
  title="Workshops for Students | Navadisha"
  description="Practical technology workshops for school and college students in Nepal. Currently one planned workshop — AI for Students, dates being confirmed."
  pillar="education"
>
  <PageHero
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Students', href: '/students/' },
      { label: 'Workshops' },
    ]}
    eyebrow="Workshops"
    title="One workshop planned. Nothing you can book yet."
    lede="We would rather show you exactly where things stand than fill this page with sessions that do not exist."
  />

  <Section tone="sunken" labelledby="ai-h">
    <CompassRule pillar />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--pillar);">
      Planned
    </p>
    <h2 id="ai-h" class="mt-4" style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;">
      AI for Students
    </h2>

    <div class="mt-10 grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ProgramStatusBlock
          status="planned"
          facts={facts}
          note="This workshop has not run yet. Registering interest costs nothing and commits you to nothing."
        />
      </div>

      <div class="lg:col-span-7">
        <p class="measure" style="font-size: var(--text-body-lg); color: var(--text-secondary);">
          A one-day practical introduction to AI, for students in school and college. Run by
          someone who builds software and delivers digital literacy training, rather than by a
          separate training department.
        </p>
        <p class="mt-5 measure" style="color: var(--text-secondary);">
          There is no syllabus published yet, because the workshop is still being designed.
          Publishing one now would either constrain the design or become a promise we have to
          break — so it will appear here when it is real.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          {wa && <Button href={wa} note="Usually a reply within a day" arrow>Tell us you are interested</Button>}
          <Button href="/programs/ai-for-students/" variant="secondary">Full programme details</Button>
        </div>
      </div>
    </div>
  </Section>

  {/* ── Honest answers, high on the page rather than buried ── */}
  <Section labelledby="honest-h">
    <CompassRule pillar />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Straight answers
    </p>
    <h2 id="honest-h" class="mt-4" style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;">
      The questions you would actually ask.
    </h2>

    <dl class="mt-10 measure space-y-8">
      {
        honest.map((h) => (
          <div class="border-t pt-6 first:border-t-0 first:pt-0" style="border-color: var(--border-subtle);">
            <dt style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 700; letter-spacing: -0.012em;">
              {h.q}
            </dt>
            <dd class="mt-3 text-sm" style="color: var(--text-secondary);">
              {h.a}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {/* ── Coming later ── */}
  <Section tone="sunken" labelledby="later-h">
    <CompassRule pillar />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Later
    </p>
    <h2 id="later-h" class="mt-4" style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;">
      What else is being built.
    </h2>
    <p class="mt-6 measure" style="color: var(--text-secondary);">
      These have no dates and no detail yet. They are listed so you know the direction, not
      because you can join them.
    </p>

    <ul class="mt-8 flex flex-wrap gap-3">
      {
        inDev.map((p) => (
          <li
            class="rounded-full border px-4 py-2 text-sm"
            style="border-color: var(--border-default); color: var(--text-secondary);"
          >
            {p.title}
          </li>
        ))
      }
    </ul>

    <p class="mt-8">
      <a href="/programs/" class="text-sm font-semibold" style="color: var(--text-accent);">
        The full training practice →
      </a>
    </p>
  </Section>

  <Section tone="inverse" labelledby="ask-h">
    <h2 id="ask-h" style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;">
      Want to be told when dates are confirmed?
    </h2>
    <p class="mt-5 measure" style="font-size: var(--text-body-lg); color: var(--text-on-inverse-muted);">
      Message us and we will let you know. No payment, no form, and no follow-up sales calls.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      {wa && <Button href={wa} note="Usually a reply within a day" arrow>Message us on WhatsApp</Button>}
      <Button href="/students/" variant="secondary">Back to student page</Button>
    </div>
  </Section>
</Base>
