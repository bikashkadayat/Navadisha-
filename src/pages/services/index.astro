---
/**
 * SERVICES INDEX
 * §5.4: the primary organic landing surface — search demand is service-shaped
 * ("website company Nepal"), so this page carries intent-driven traffic.
 *
 * One of only three places where both pillar accents appear together, because
 * here the duality IS the message (§9.2 accent discipline).
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const pillars = [
  {
    key: 'education' as const,
    id: 'education',
    name: 'Education',
    intro: 'For institutions that need direction, and the students inside them.',
  },
  {
    key: 'technology' as const,
    id: 'technology',
    name: 'Technology',
    intro: 'For anyone whose systems, brand or presence is holding them back.',
  },
];
---

<Base
  title="Services | Navadisha Consulting & Innovations"
  description="Education consulting and technology services for Nepali institutions and businesses — advisory, web, software, branding, marketing and training."
>
  <Section width="wide" labelledby="svc-h">
    <h1 id="svc-h" style="font-size: var(--text-display-lg);">Services</h1>
    <p class="mt-6 measure" style="font-size: var(--text-body-lg); color: var(--text-secondary);">
      Two practices. Most engagements start in one and end up drawing on both — which is
      usually the point.
    </p>
  </Section>

  {
    pillars.map((p, idx) => (
      <Section
        id={p.id}
        pillar={p.key}
        tone={idx % 2 === 0 ? 'sunken' : 'page'}
        labelledby={`${p.id}-h`}
      >
        <p class="text-[0.625rem] font-bold uppercase tracking-[0.14em]" style="color: var(--pillar);">
          {p.name}
        </p>
        <h2 id={`${p.id}-h`} class="mt-3 measure" style="font-size: var(--text-heading-xl);">
          {p.intro}
        </h2>

        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {services
            .filter((s) => s.data.pillar === p.key)
            .map((s) => (
              <li>
                <a
                  href={`/services/${s.id}/`}
                  class="block h-full rounded-xl border p-6 transition-transform duration-200 hover:-translate-y-1"
                  style="background-color: var(--surface-raised); border-color: var(--border-subtle); border-left: 3px solid var(--pillar);"
                >
                  <p class="font-semibold" style="font-family: var(--font-display); font-size: var(--text-heading-md);">
                    {s.data.title}
                  </p>
                  <p class="mt-2 text-sm" style="color: var(--text-secondary);">{s.data.summary}</p>
                </a>
              </li>
            ))}
        </ul>
      </Section>
    ))
  }

  {/* The "not sure" route: catches visitors whose problem spans both pillars
       and who would otherwise bounce off a service list (§6.3). */}
  <Section tone="inverse" labelledby="unsure-h">
    <h2 id="unsure-h" style="font-size: var(--text-heading-lg);">Not sure where to start?</h2>
    <p class="mt-4 measure" style="color: var(--text-on-inverse-muted);">
      Most problems worth solving do not arrive labelled with a service name. Describe the
      situation and we will tell you which of these it actually is — or that it is neither.
    </p>
    <div class="mt-8">
      <Button href="/contact/" note="No cost, no obligation">Book a 30-minute call</Button>
    </div>
  </Section>
</Base>
