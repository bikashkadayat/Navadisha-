---
/**
 * COMPANY & COMPLIANCE
 * Copy: content-decks/about-batch1.md (approved, production)
 *
 * This page exists for the buyers who cannot proceed without it: university
 * procurement, NGO programme managers working to donor compliance rules, and
 * public-sector officers. Most Nepali company sites omit compliance data
 * entirely — publishing it is a low-effort differentiator.
 *
 * ⚠ Registration is IN PROGRESS. Everything below is driven by
 * `src/data/company.ts`. There are no placeholder registration numbers and no
 * empty labelled fields waiting to be filled — an unexplained blank where a
 * buyer expects compliance data reads worse than an honest status statement.
 *
 * When the certificate is issued: populate `registration` and flip
 * `REGISTRATION_STATUS`. The pending notice is replaced by the real table and
 * the LocalBusiness JSON-LD begins emitting. No template change.
 */
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import PageHero from '../../../components/PageHero.astro';
import CompassRule from '../../../components/CompassRule.astro';
import ConversionBand from '../../../components/ConversionBand.astro';
import {
  company,
  hasComplianceData,
  hasContactData,
  registrationNotice,
} from '../../../data/company.ts';

const showCompliance = hasComplianceData();
const notice = registrationNotice();

const addr = [company.contact.address.street, company.contact.address.city, 'Nepal']
  .filter(Boolean)
  .join(', ');

/** Fields that will appear here once incorporation completes. */
const futureFields = [
  'Company registration number',
  'PAN / VAT number',
  'Date of incorporation',
  'Registered office address',
  'Tax clearance status',
];
---

<Base
  title="Company & Compliance | Navadisha"
  description="Navadisha company information — founder-led practice based in Kathmandu, Nepal. Contact details, current registration status and compliance information."
>
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Company' }]}
    eyebrow="Company & compliance"
    title="Company information, stated as it currently stands."
    lede="Organisations with procurement or donor-compliance requirements need to verify who they are contracting with. This page holds that information, including what is not yet in place."
  />

  {/* ── Current structure ── */}
  <Section tone="sunken" labelledby="structure-h">
    <CompassRule />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Current structure
    </p>
    <h2
      id="structure-h"
      class="mt-4"
      style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;"
    >
      A founder-led practice operating from Kathmandu.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
          Operating name
        </h3>
        <p class="mt-4" style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          {company.displayName}
        </p>
      </div>

      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
          Structure
        </h3>
        <p class="mt-4" style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          Founder-led practice
        </p>
        <p class="mt-2 text-sm" style="color: var(--text-secondary);">
          Two founders. No intermediary account management.
        </p>
      </div>

      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
          Base of operations
        </h3>
        <p class="mt-4" style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          {addr}
        </p>
      </div>
    </div>

    <p class="mt-8">
      <a href="/about/team/" class="text-sm font-semibold" style="color: var(--text-accent);">
        See who you would be working with →
      </a>
    </p>
  </Section>

  {/* ── Registration status ── */}
  <Section labelledby="reg-h">
    <CompassRule />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Registration
    </p>
    <h2
      id="reg-h"
      class="mt-4"
      style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;"
    >
      {showCompliance ? 'Registration and tax details' : 'Registration is in progress.'}
    </h2>

    {
      showCompliance ? (
        <div class="mt-10">
          <dl class="grid gap-px overflow-hidden rounded-xl border" style="background-color: var(--border-subtle); border-color: var(--border-subtle);">
            {[
              ['Registered legal name', company.legalName],
              ['Company registration number', company.registration.companyNumber],
              ['PAN / VAT number', company.registration.panVat],
              ['Date of incorporation', company.registration.incorporated],
              ['Registered address', company.registration.registeredAddress],
            ].map(([k, v]) => (
              <div class="grid gap-2 p-6 sm:grid-cols-3" style="background-color: var(--surface-raised);">
                <dt class="text-sm" style="color: var(--text-tertiary);">{k}</dt>
                <dd class="sm:col-span-2" style="font-weight: 620;">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      ) : (
        <div class="mt-8 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <div class="space-y-5 measure" style="color: var(--text-secondary);">
              <p>{notice}</p>
              <p>
                We have chosen to state this openly rather than leave the section blank. An
                organisation carrying out due diligence needs to know the position, and finding
                nothing is more concerning than finding an honest answer.
              </p>
              <p>
                <strong style="color: var(--text-primary);">What this means in practice.</strong>{' '}
                We are currently able to work with private institutions, businesses and
                organisations that do not require a registration certificate as a condition of
                engagement. We are <em>not</em> currently able to participate in public tenders
                or in donor-funded procurement where registration and tax clearance are a
                prerequisite. If your process requires those documents, we will tell you at the
                first conversation rather than partway through.
              </p>
            </div>
          </div>

          <div class="lg:col-span-5 lg:pl-4">
            <div
              class="rounded-xl border p-8"
              style="background-color: var(--surface-raised); border-color: var(--border-subtle); border-left-width: 3px; border-left-color: var(--pillar-edu-fill);"
            >
              <h3 class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
                Published here on completion
              </h3>
              <ul class="mt-5 space-y-3">
                {futureFields.map((f) => (
                  <li class="text-sm" style="color: var(--text-secondary);">
                    {f}
                  </li>
                ))}
              </ul>
              <p class="mt-6 text-sm" style="color: var(--text-tertiary);">
                This page is the permanent location for those details. If you are assessing us
                for a future engagement, check back here.
              </p>
            </div>
          </div>
        </div>
      )
    }
  </Section>

  {/* ── Contact ── */}
  <Section tone="sunken" labelledby="contact-h">
    <CompassRule />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Contact
    </p>
    <h2
      id="contact-h"
      class="mt-4"
      style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;"
    >
      Verified contact details.
    </h2>

    <dl class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        hasContactData() && (
          <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
            <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
              Telephone
            </dt>
            <dd class="mt-4">
              <a href={`tel:${company.contact.phone}`} style="font-weight: 620; color: var(--text-primary);">
                {company.contact.phoneDisplay}
              </a>
            </dd>
          </div>
        )
      }

      {
        company.contact.email && (
          <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
            <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
              Email
            </dt>
            <dd class="mt-4">
              <a href={`mailto:${company.contact.email}`} style="font-weight: 620; color: var(--text-primary); word-break: break-word;">
                {company.contact.email}
              </a>
            </dd>
          </div>
        )
      }

      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
          Office
        </dt>
        <dd class="mt-4" style="font-weight: 620;">{addr}</dd>
      </div>

      {
        company.contact.officeHours && (
          <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
            <dt class="text-[0.6875rem] font-bold uppercase tracking-[0.13em]" style="color: var(--text-tertiary);">
              Hours
            </dt>
            <dd class="mt-4" style="font-weight: 620;">{company.contact.officeHours}</dd>
          </div>
        )
      }
    </dl>

    <p class="mt-8 text-sm" style="color: var(--text-secondary);">
      {company.responseCommitment}
    </p>
  </Section>

  {/* ── Working with us ── */}
  <Section labelledby="working-h">
    <CompassRule />
    <p class="mt-6 text-[0.6875rem] font-bold uppercase tracking-[0.14em]" style="color: var(--text-tertiary);">
      Working with us
    </p>
    <h2
      id="working-h"
      class="mt-4 measure"
      style="font-size: var(--text-heading-xl); font-weight: 780; letter-spacing: -0.028em;"
    >
      Commercial terms, stated before you ask.
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          Pricing
        </h3>
        <p class="mt-3 text-sm" style="color: var(--text-secondary);">
          Quoted on request, after a first conversation. We do not publish rate cards because
          pricing work before understanding it produces a number that has to be revised. The
          diagnostic stage is quoted as a fixed fee; delivery is scoped after it.
        </p>
      </div>

      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          Ownership
        </h3>
        <p class="mt-3 text-sm" style="color: var(--text-secondary);">
          Source files, accounts and credentials transfer to the client at close. We do not
          retain control of a client’s infrastructure, and we do not use proprietary systems that
          would make replacing us costly.
        </p>
      </div>

      <div class="rounded-xl border p-7" style="background-color: var(--surface-raised); border-color: var(--border-subtle);">
        <h3 style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720;">
          Ongoing support
        </h3>
        <p class="mt-3 text-sm" style="color: var(--text-secondary);">
          Available, but structured as a defined taper rather than an open retainer. The
          engagement is designed so that continuing support is a choice rather than a
          requirement.
        </p>
      </div>
    </div>
  </Section>

  <ConversionBand
    heading="Questions about how we work?"
    lede="If your organisation has procurement or compliance requirements, tell us early. We will say plainly whether we can meet them today."
  />
</Base>
