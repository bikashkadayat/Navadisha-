---
/**
 * Phase-2 design §11 S8.
 *
 * With no testimonials and no client logo wall, the named founders ARE the
 * homepage's social proof — and unlike the alternatives, this proof is real.
 *
 * Photography does not exist yet. The initials fallback sets them in Manrope
 * 800 on the primary fill: it looks deliberate, where a grey silhouette
 * placeholder looks like an oversight. Populating `photo` upgrades it.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'>;
  /** Homepage uses the short form; the team page uses the full bio. */
  compact?: boolean;
}
const { member, compact = false } = Astro.props;
const d = member.data;

const initials = d.name
  .split(/\s+/)
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div
  class="rounded-xl border p-7"
  style="background-color: var(--surface-raised); border-color: var(--border-subtle);"
>
  <div class="flex items-start gap-5">
    {
      d.photo ? (
        <img
          src={d.photo}
          alt={d.name}
          width="72"
          height="72"
          class="h-18 w-18 shrink-0 rounded-full object-cover"
          loading="lazy"
        />
      ) : (
        <span
          aria-hidden="true"
          class="flex shrink-0 items-center justify-center rounded-full"
          style="width: 4.5rem; height: 4.5rem; background-color: var(--action-primary-default); color: var(--action-primary-text); font-family: var(--font-display); font-size: 1.375rem; font-weight: 800; letter-spacing: -0.03em;"
        >
          {initials}
        </span>
      )
    }

    <div class="min-w-0">
      <h3
        style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 720; letter-spacing: -0.012em;"
      >
        {d.name}
      </h3>
      <p class="mt-1 text-sm font-semibold" style="color: var(--text-accent);">{d.role}</p>
    </div>
  </div>

  {
    !compact && d.credentials.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {d.credentials.map((c) => (
          <li
            class="rounded px-2.5 py-1 text-xs"
            style="background-color: var(--surface-sunken); color: var(--text-secondary);"
          >
            {c}
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-5 text-sm" style="color: var(--text-secondary);">
    <slot />
  </p>
</div>
