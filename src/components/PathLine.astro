---
/**
 * SIGNATURE DEVICE 3 — the path line.
 * Phase-2 design §02 and §09. The literal drawing of "knowledge pathways".
 *
 * Renders a sequence of labelled nodes joined by a line. Horizontal on desktop,
 * vertical on mobile, identical semantics either way.
 *
 * MOTION CONTRACT (§09): the line draws once on scroll-into-view, 700ms, and
 * never loops. Under prefers-reduced-motion the final state is delivered
 * immediately — handled by the global rule in global.css, not per-component.
 *
 * NO-JS CONTRACT: nodes and labels are plain markup and fully readable without
 * script. The draw animation enhances content that is already there; it never
 * reveals content that is otherwise hidden.
 */
interface Node {
  label: string;
  detail: string;
  /** Optional tint for a specific node — used by the bridge diagram. */
  accent?: string;
}
interface Props {
  nodes: Node[];
  /** Numbered variant for the method sequence. */
  numbered?: boolean;
  class?: string;
}
const { nodes, numbered = false, class: className = '' } = Astro.props;
---

{/* Grid columns set inline: a dynamic `md:grid-cols-${n}` class would never be
     compiled, because Tailwind scans source text and cannot see a runtime value. */}
<ol
  class={`path-line grid gap-8 ${className}`}
  style={`--cols: ${nodes.length};`}
  data-pathline
>
  {
    nodes.map((n, i) => (
      <li class="path-node relative" style={`--i: ${i}`}>
        {/* Connector. Hidden on the last node and on mobile, where the list
            reads top-to-bottom and the vertical rule below takes over. */}
        {i < nodes.length - 1 && (
          <span
            class="path-connector absolute hidden md:block"
            style="top: 5px; left: calc(12px + 0.75rem); right: -1.5rem; height: 1.5px; background-color: var(--border-default); transform-origin: left center;"
            aria-hidden="true"
          />
        )}

        <span
          class="path-dot relative z-10 block rounded-full"
          style={`width: 12px; height: 12px; background-color: ${n.accent ?? 'var(--action-primary-default)'};`}
          aria-hidden="true"
        />

        {numbered && (
          <span
            class="mt-5 block tabular"
            style="font-family: var(--font-display); font-size: 2rem; font-weight: 800; line-height: 1; color: var(--text-decorative); letter-spacing: -0.04em;"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
        )}

        <h3
          class={numbered ? 'mt-3' : 'mt-5'}
          style="font-family: var(--font-display); font-size: var(--text-heading-sm); font-weight: 700; letter-spacing: -0.012em;"
        >
          {n.label}
        </h3>
        <p class="mt-2" style="font-size: var(--text-body-sm); color: var(--text-secondary);">
          {n.detail}
        </p>
      </li>
    ))
  }
</ol>

<style>
  @media (min-width: 768px) {
    .path-line {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }

  /* Vertical rule on mobile — the same semantics rotated. */
  @media (max-width: 767px) {
    .path-line {
      position: relative;
      padding-left: 1.5rem;
    }
    .path-line::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 6px;
      bottom: 6px;
      width: 1.5px;
      background-color: var(--border-default);
    }
    .path-node .path-dot {
      position: absolute;
      left: -1.5rem;
      top: 4px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-pathline].is-visible .path-connector {
      animation: draw 700ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 90ms);
      transform: scaleX(0);
    }
    [data-pathline].is-visible .path-dot {
      animation: pop 300ms ease-out forwards;
      animation-delay: calc(var(--i) * 90ms + 200ms);
      opacity: 0;
    }
    @keyframes draw {
      to { transform: scaleX(1); }
    }
    @keyframes pop {
      from { opacity: 0; transform: scale(0.4); }
      to   { opacity: 1; transform: scale(1); }
    }
  }
</style>

<script>
  // Adds .is-visible once, on scroll into view. Never replays.
  const lines = document.querySelectorAll('[data-pathline]');
  if (lines.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.2 },
    );
    lines.forEach((l) => io.observe(l));
  }
</script>
