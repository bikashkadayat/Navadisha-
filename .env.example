# ============================================================================
# NAVADISHA — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
#
#   cp .env.example .env
#
# ⚠ TWO CLASSES OF VALUE LIVE HERE, AND THEY ARE NOT INTERCHANGEABLE.
#
#   PUBLIC_*   Baked into the client bundle at build time. Readable by anyone
#              who views source. Never put a secret behind this prefix.
#
#   Everything else in this file is used only by CLI tooling on your machine.
#   The Worker's real secrets are NOT here and must never be — they are set
#   with `wrangler secret put`, which stores them encrypted at Cloudflare.
#   See worker/DEPLOYMENT.md.
# ============================================================================


# ── Site ────────────────────────────────────────────────────────────────────
# The production origin. Scheme included, NO trailing slash.
# Drives canonical URLs, Open Graph tags and the sitemap — a wrong value here
# is a silent SEO failure that surfaces weeks later as duplicate content.
#
# In CI this comes from the `SITE_URL` repository variable, not from this file.
SITE_URL=https://navadisha.bikashkadayat.com.np


# ── Contact form ────────────────────────────────────────────────────────────
# The deployed Cloudflare Worker endpoint. Baked in at build time, so the site
# must be REBUILT after this changes.
#
# Leave empty until the Worker is deployed. The form then fails gracefully: it
# tells the visitor the message channel is not live and offers WhatsApp and
# phone, both of which work. Nobody is left with a form that silently fails.
#
# Prefer a route on your own domain over a *.workers.dev address — same-origin
# avoids the CORS preflight and does not show a third-party host to a visitor
# who is deciding whether to trust you.
#   e.g. https://navadisha.bikashkadayat.com.np/api/contact
PUBLIC_FORM_ENDPOINT=


# ── Cloudflare ──────────────────────────────────────────────────────────────
# Used by wrangler from the command line. Not needed by the site build.
# Account ID: Cloudflare dashboard → Workers & Pages → right-hand sidebar.
CLOUDFLARE_ACCOUNT_ID=

# KV namespace id for lead storage. Created with:
#   npx wrangler kv namespace create LEADS
# The same id must also be pasted into worker/wrangler.toml.
#
# ⚠ This namespace is the enquiry history AND the Phase-2 CRM's seed data.
#   Never delete it. A Worker redeploy does not touch it; only an explicit
#   delete does, and there is no undo.
CLOUDFLARE_KV_NAMESPACE=


# ── Turnstile (optional) ────────────────────────────────────────────────────
# Cloudflare's privacy-friendly CAPTCHA alternative. Optional — the form keeps
# a honeypot and per-IP rate limiting without it, which stops most automated
# submission. Add it if spam becomes a real problem.
#
# SITE key is public and safe to expose; it is rendered into the page.
PUBLIC_TURNSTILE_SITE_KEY=

# SECRET key must NOT live in .env for production use.
# Set it with:  cd worker && npx wrangler secret put TURNSTILE_SECRET
# It is listed here only so the pairing is obvious. Leave it blank.
TURNSTILE_SECRET_KEY=


# ── Email ───────────────────────────────────────────────────────────────────
# Where contact form notifications are delivered.
#
# ⚠ Sending and receiving are DIFFERENT services. The transactional provider
#   can send AS this address; it cannot deliver TO it. Confirm this mailbox
#   actually receives mail before launch — it is published on nine pages and
#   is the destination for every form submission.
NOTIFY_EMAIL=contact@navadisha.com.np

# The transactional provider API key is a Worker secret, not an env var:
#   cd worker && npx wrangler secret put RESEND_API_KEY
# Listed here for completeness only. Leave blank.
RESEND_API_KEY=
